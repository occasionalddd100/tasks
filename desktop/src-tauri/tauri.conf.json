{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasks",
  "mainBinaryName": "tasks",
  "version": "1.0.0",
  "identifier": "io.github.occasionalddd100.tasks.desktop",
  "build": { "frontendDist": "https://occasionalddd100.github.io/tasks/" },
  "app": {
    "windows": [
      {
        "label": "main",
